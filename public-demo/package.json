{
  "name": "ghost-protocol-public-synthetic-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
