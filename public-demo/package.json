    "test:e2e": "playwright test",
    "scan": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
